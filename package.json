{
  "name": "osvm-mcp",
  "version": "0.1.0",
  "description": "opensvm api mcp",
  "private": true,
  "type": "module",
  "bin": {
    "osvm-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
